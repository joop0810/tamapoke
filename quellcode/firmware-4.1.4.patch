 //   SD MOUNT [FORMAT]\n                    -> mount a card; FORMAT one it cannot read
+//   FORMAT\n                              -> Dennis build: empty the WHOLE card (see below)
 // Usar con tools/send_sd.py
 // ---------------------------------------------------------------------------
 
@@ -296,7 +297,77 @@ static void invalidatePackForPath(const String &path) {
     invalidatePackMarker(regionOfDex((int16_t)dex));
 }
 
+// ---------------------------------------------------------------------------
+// Dennis build: FORMAT empties the whole card so a new sprite set starts clean.
+//
+// The card sits inside the case and cannot be taken out, and nothing else ever
+// deletes: a PUT only overwrites the names it sends, so a card that once held
+// other regions keeps them -- and they stay playable, because the art probe finds
+// them. SD MOUNT FORMAT does not help, it only formats a card that will NOT mount.
+//
+// This is a full wipe of the mounted FAT volume (every file and folder, hidden
+// ones and the .pack-N markers included), not a low-level mkfs: SD_MMC exposes no
+// format call. The save lives in NVS flash and is not touched.
+//
+// Replies "FORMAT <n>" every 50 deletions, then "FORMAT OK <n>" + "DONE", or
+// "FORMAT ERR <why>" + "ERR" -- the DONE/ERR ending every other command here uses.
+// ---------------------------------------------------------------------------
+
+// Deletes everything inside `dir` (not `dir` itself), in small batches so it never
+// holds more than a few dozen paths in RAM. False if something could not go.
+static bool sdWipeDir(const String &dir, uint32_t &removed, uint8_t depth = 0) {
+  if (depth > 8) return false;                 // a cycle in a corrupt FS, not a tree
+  const int BATCH = 32;
+  while (true) {
+    String files[BATCH], dirs[BATCH];
+    int nf = 0, nd = 0;
+    File d = SD_MMC.open(dir);
+    if (!d || !d.isDirectory()) { if (d) d.close(); return false; }
+    File e;
+    while (nf < BATCH && nd < BATCH && (e = d.openNextFile())) {
+      String p = e.path();
+      if (e.isDirectory()) dirs[nd++] = p; else files[nf++] = p;
+      e.close();
+    }
+    d.close();
+    if (nf == 0 && nd == 0) return true;        // empty: done
+
+    int progress = 0;
+    for (int i = 0; i < nf; i++) {
+      if (!SD_MMC.remove(files[i])) continue;
+      removed++; progress++;
+      if (removed % 50 == 0) Serial.printf("FORMAT %u\n", (unsigned)removed);
+    }
+    for (int i = 0; i < nd; i++) {
+      if (!sdWipeDir(dirs[i], removed, depth + 1)) return false;
+      if (SD_MMC.rmdir(dirs[i])) { removed++; progress++; }
+    }
+    if (progress == 0) return false;             // same entries came back: stuck
+    delay(1);                                    // let the idle task / watchdog run
+  }
+}
+
+static void sdFormatCommand() {
+  if (!sdReady) { Serial.println("FORMAT ERR nocard"); Serial.println("ERR"); return; }
+  activePackRegion = -1;
+  uint32_t removed = 0;
+  bool ok = sdWipeDir("/", removed);
+  SD_MMC.mkdir("/mons");
+  // The sprites in RAM came from files that no longer exist: reload (the game
+  // falls back to its flash art) and re-derive which regions have art -- none,
+  // until new packs arrive.
+  sdDirty = true;
+  sdArtDirty = true;
+  sdTransferAt = 0;
+  if (ok) { Serial.printf("FORMAT OK %u\n", (unsigned)removed); Serial.println("DONE"); }
+  else    { Serial.println("FORMAT ERR wipe"); Serial.println("ERR"); }
+}
+
 bool sdSerialCommand(const String &line) {
+  if (line == "FORMAT") {
+    sdFormatCommand();
+    return true;
+  }
   if (line.startsWith("PUT ")) {
     int sp = line.lastIndexOf(' ');
     String path = line.substring(4, sp);
