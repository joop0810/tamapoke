+// Dennis build: the bag shows each ball's catch chance, and the number shown is
+// the roll the throw makes (one function for both).
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "items.h"
+#include "inventory.h"
+#include "i18n.h"
+#include <cstdio>
+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+bool startWildBattle(uint8_t region, bool hard);
+uint8_t btlCatchChance(uint8_t k);
+extern Pet pet; extern Inventory bag; extern Arduino_Canvas *gfx;
+extern uint16_t squadMask; extern uint8_t btlMenu, btlBagPage, btlMsgCount;
+extern bool btlWild; extern Combatant btlFoe;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.ageMinutes = 9UL * MINUTES_PER_LEVEL;
+  bag.add(IT_GREATBALL, 2); bag.add(IT_ULTRABALL, 1); bag.add(IT_MASTERBALL, 1);
+  squadMask = 0x1;
+  CHECK(startWildBattle(0, false), "a wild encounter starts");
+  for (int i = 0; i < 6; i++) loop();
+  btlMsgCount = 0;
+
+  uint8_t rar = DEX_TBL[btlFoe.dex].rarity;
+  btlFoe.hp = btlFoe.maxHp;
+  CHECK(btlCatchChance(IT_POKEBALL) == wildCaptureChance(rar, btlFoe.hp, btlFoe.maxHp, false, 100),
+        "the shown chance is the throw's own formula");
+  uint8_t full = btlCatchChance(IT_POKEBALL);
+  btlFoe.hp = 1;
+  uint8_t low = btlCatchChance(IT_POKEBALL);
+  CHECK(low > full, "weakening it raises the shown chance");
+  CHECK(btlCatchChance(IT_GREATBALL) > low && btlCatchChance(IT_ULTRABALL) >= btlCatchChance(IT_GREATBALL),
+        "better balls show more");
+  CHECK(btlCatchChance(IT_MASTERBALL) == 100, "the Master Ball shows 100 %");
+  CHECK(btlCatchChance(IT_POTION) == 0, "a potion has no catch chance");
+  printf("      %s: full HP %u%%, 1 HP %u%% / great %u%% / ultra %u%%\n", speciesName(btlFoe.dex),
+         full, low, btlCatchChance(IT_GREATBALL), btlCatchChance(IT_ULTRABALL));
+
+  btlFoe.hp = btlFoe.maxHp / 5;
+  btlMenu = 3; btlBagPage = 0;
+  gLang = LANG_DE;
+  shot("catch_bag.ppm");
+  btlWild = false;
+  CHECK(btlCatchChance(IT_POKEBALL) == 0, "no chance against a trainer's creature");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
