+}
+
+void btlAwardExp(bool narrate) {
+  if (btlLink) return;
+  uint8_t kind = btlWild ? EXP_WILD
+               : (btlTrainer >= 0 && btlTrainer < TRAINER_GYMS ? EXP_GYM : EXP_ELITE);
+  uint8_t foeLv[TRAINER_TEAM_MAX];
+  uint8_t foes = 0;
+  if (btlWild) foeLv[foes++] = btlFoe.level;
+  else if (btlTrainer >= 0) {
+    const Trainer &t = BTL_TRAINERS[btlTrainer];
+    for (uint8_t i = 0; i < t.count && i < TRAINER_TEAM_MAX; i++) foeLv[foes++] = t.team[i].level;
+  }
+  if (!foes) return;
+  bool partyChanged = false;
+  for (uint8_t k = 0; k < btlSquadN; k++) {
+    if (!(btlFought & (1u << k))) continue;
+    int8_t src = btlSquadSrc[k];
+    if (src < -1 || src >= PARTY_SLOTS) continue;
+    uint8_t before = src == -1 ? pet.level() : (uint8_t)party.slots[src].level;
+    if (before >= MAX_LEVEL) continue;
+    uint32_t got = 0;
+    for (uint8_t f = 0; f < foes; f++) got += battleExpMinutes(kind, btlHard, foeLv[f], before);
+    uint8_t after;
+    const char *nm;
+    if (src == -1) {
+      after = pet.gainExp(got, false);   // written by the save queue
+      nm = pet.nick[0] ? pet.nick : speciesName(pet.speciesId);
+    } else {
+      PartyMon &m = party.slots[src];
+      if (m.empty()) continue;
+      // A pre-care-state record keeps its age only in `level`: start from that.
+      uint32_t age = m.hasCareState() ? m.ageMinutes : (uint32_t)(m.level - 1) * MINUTES_PER_LEVEL;
+      age += got;
+      m.ageMinutes = age;
+      uint32_t l = 1 + age / MINUTES_PER_LEVEL;
+      m.level = (uint16_t)(l > MAX_LEVEL ? MAX_LEVEL : l);
+      after = (uint8_t)m.level;
+      partyChanged = true;
+      nm = m.nick[0] ? m.nick : speciesName(m.dex);
+    }
+    if (!btlExpName[0]) {
+      snprintf(btlExpName, sizeof(btlExpName), "%s", nm);
+      btlExpGot = (uint16_t)(got > 65535 ? 65535 : got);
+      btlExpLevel = after;
+      btlExpLevelUp = after > before;
+    }
+    if (narrate) {
+      if (after > before) btlSay(T(S_EXP_LVUP), nm, after);
+      else btlSay(T(S_EXP_GAIN), nm, (unsigned)got);
+    }
+  }
+  saveQueue(SQ_PET | (partyChanged ? SQ_PARTY : 0));   // spaced, not back to back
+}
