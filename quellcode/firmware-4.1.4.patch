+// The members of `dex`'s line that this board can actually hold (a stage from a
+// region whose sprites are not installed does not count), how many of them are
+// in the Pokedex, and the first one that is not. Returns the member count.
+uint8_t lineStats(int16_t dex, uint8_t *have, int16_t *missing) {
+  int16_t mem[12]; uint8_t n = 0;
+  int16_t cur = lineBase(dex);
+  for (int guard = 0; guard < 6 && cur >= 1 && cur <= DEX_COUNT && n < 12; guard++) {
+    if (!regionAvailable(regionOfDex(cur))) break;
+    mem[n++] = cur;
