diff --git a/hof.cpp b/hof.cpp
new file mode 100644
index 00000000..98dfaf79
--- /dev/null
+++ b/hof.cpp
@@ -0,0 +1,134 @@
+// Dennis build: Hall of Fame storage. See hof.h.
+#include "hof.h"
+#include <string.h>
+
+static const char HOF_MAGIC[4] = { 'T', 'P', 'H', 'F' };
+static const uint8_t HOF_VERSION = 1;
+static bool gReady = false;
+static uint16_t gCount = 0;
+
+#if defined(ARDUINO_ARCH_ESP32)
+#include <FS.h>
+#include <FFat.h>
+#define HOF_PATH "/hof.bin"
+static File hofOpen(const char *mode) { return FFat.open(HOF_PATH, mode); }
+static bool hofMount() { return FFat.begin(true /* format the never-used partition once */); }
+static bool hofWipe() { FFat.remove(HOF_PATH); return true; }
+struct HofFile {
+  File f;
+  explicit HofFile(const char *mode) : f(hofOpen(mode)) {}
+  ~HofFile() { if (f) f.close(); }
+  bool ok() const { return (bool)f; }
+  size_t size() { return f.size(); }
+  bool seek(size_t p) { return f.seek(p); }
+  size_t read(void *b, size_t n) { return f.read((uint8_t *)b, n); }
+  size_t write(const void *b, size_t n) { return f.write((const uint8_t *)b, n); }
+};
+#else
+// Host (emulator / tests): a plain file in the working directory.
+#include <stdio.h>
+#define HOF_PATH "hof.bin"
+static bool hofMount() { return true; }
+static bool hofWipe() { remove(HOF_PATH); return true; }
+struct HofFile {
+  FILE *f;
+  explicit HofFile(const char *mode) {
+    const char *m = !strcmp(mode, "r") ? "rb" : (!strcmp(mode, "a") ? "ab" : "wb");
+    f = fopen(HOF_PATH, m);
+  }
+  ~HofFile() { if (f) fclose(f); }
+  bool ok() const { return f != nullptr; }
+  size_t size() { long p = ftell(f); fseek(f, 0, SEEK_END); long s = ftell(f); fseek(f, p, SEEK_SET); return s < 0 ? 0 : (size_t)s; }
+  bool seek(size_t p) { return fseek(f, (long)p, SEEK_SET) == 0; }
+  size_t read(void *b, size_t n) { return fread(b, 1, n, f); }
+  size_t write(const void *b, size_t n) { return fwrite(b, 1, n, f); }
+};
+#endif
+
+static bool writeHeader() {
+  HofFile w("w");
+  if (!w.ok()) return false;
+  uint8_t h[8] = { 0 };
+  memcpy(h, HOF_MAGIC, 4);
+  h[4] = HOF_VERSION;
+  return w.write(h, 8) == 8;
+}
+
+bool hofBegin() {
+  gReady = false;
+  gCount = 0;
+  if (!hofMount()) return false;
+#if defined(ARDUINO_ARCH_ESP32)
+  FFat.remove("/diag.txt");   // the old diagnostics log, no longer written
+#endif
+  {
+    HofFile r("r");
+    if (r.ok()) {
+      uint8_t h[8];
+      size_t sz = r.size();
+      if (sz >= 8 && r.read(h, 8) == 8 && !memcmp(h, HOF_MAGIC, 4)) {
+        size_t n = (sz - 8) / sizeof(HofEntry);
+        gCount = (uint16_t)(n > HOF_MAX ? HOF_MAX : n);
+        gReady = true;
+        return true;
+      }
+    }
+  }
+  // no file yet (or not ours): start an empty one
+  gReady = writeHeader();
+  return gReady;
+}
+
+bool hofReady() { return gReady; }
+uint16_t hofCount() { return gReady ? gCount : 0; }
+
+bool hofGet(uint16_t i, HofEntry &out) {
+  if (!gReady || i >= gCount) return false;
+  HofFile r("r");
+  if (!r.ok() || !r.seek(8 + (size_t)i * sizeof(HofEntry))) return false;
+  return r.read(&out, sizeof(out)) == sizeof(out);
+}
+
+bool hofAppendRaw(const HofEntry &e) {
+  if (!gReady || gCount >= HOF_MAX || e.dex < 1) return false;
+  HofFile a("a");
+  if (!a.ok() || a.write(&e, sizeof(e)) != sizeof(e)) return false;
+  gCount++;
+  return true;
+}
+
+static bool sameCreature(const HofEntry &e, const PartyMon &m) {
+  return e.dex == m.dex && e.shiny == m.shiny && e.ivAtk == m.ivAtk && e.ivDef == m.ivDef &&
+         e.ivSpe == m.ivSpe && e.ivHp == m.ivHp && !strncmp(e.nick, m.nick, sizeof(e.nick));
+}
+
+bool hofRecord(const PartyMon &m, uint8_t how, uint32_t epoch) {
+  if (!gReady || m.empty()) return false;
+  if (how == HOF_RELEASED) {
+    // honoured at its farewell already? then its release is not a second entry
+    for (uint16_t i = 0; i < gCount; i++) {
+      HofEntry e;
+      if (hofGet(i, e) && e.how == HOF_FAREWELL && sameCreature(e, m)) return false;
+    }
+  }
+  HofEntry e;
+  memset(&e, 0, sizeof(e));
+  e.dex = m.dex;
+  e.level = (uint8_t)(m.level > 100 ? 100 : m.level);
+  e.shiny = m.shiny;
+  e.how = how;
+  e.ivAtk = m.ivAtk; e.ivDef = m.ivDef; e.ivSpe = m.ivSpe; e.ivHp = m.ivHp;
+  memcpy(e.nick, m.nick, sizeof(e.nick));
+  e.nick[sizeof(e.nick) - 1] = 0;
+  e.when = epoch;
+  e.medals = m.medals;
+  return hofAppendRaw(e);
+}
+
+bool hofClear() {
+  if (!gReady) return false;
+  hofWipe();
+  gCount = 0;
+  gReady = writeHeader();
+  return gReady;
+}
diff --git a/hof.h b/hof.h
new file mode 100644
index 00000000..6f9f426a
--- /dev/null
+++ b/hof.h
@@ -0,0 +1,42 @@
+#pragma once
+// Dennis build: the Hall of Fame ("Ruhmeshalle"). A read-only record of every
+// creature that said farewell or was let go for good, kept forever.
+//
+// It lives in the 9 MB "ffat" flash partition, which nothing else uses and which
+// the web installer is checked to leave alone (tools/check_installer.py lists it
+// among what must survive a flash). So it outlives firmware updates and SD wipes;
+// only "Erase device" clears it -- which is why the local tool can back it up.
+//
+// One fixed 32-byte record per creature, appended to /hof.bin after an 8-byte
+// header. The format only ever grows at the end of a record (reserved bytes).
+#include <stdint.h>
+#include "party.h"
+
+enum : uint8_t { HOF_FAREWELL = 1, HOF_RELEASED = 2 };
+
+#pragma pack(push, 1)
+struct HofEntry {
+  int16_t dex;
+  uint8_t level;
+  uint8_t shiny;
+  uint8_t how;          // HOF_FAREWELL / HOF_RELEASED
+  uint8_t ivAtk, ivDef, ivSpe, ivHp;
+  char nick[12];
+  uint32_t when;        // RTC epoch seconds, 0 if the clock was never set
+  uint16_t medals;
+  uint8_t reserved[5];
+};
+#pragma pack(pop)
+static_assert(sizeof(HofEntry) == 32, "HofEntry is a fixed 32-byte record");
+
+#define HOF_MAX 4096    // 128 KB -- far beyond a lifetime of three-day creatures
+
+bool hofBegin();                         // mount (formatting a blank partition once)
+bool hofReady();
+uint16_t hofCount();
+bool hofGet(uint16_t i, HofEntry &out);  // i = 0 is the oldest
+// Records a creature leaving. A release of one already honoured at its farewell
+// (same species, IVs, shiny and nickname) is not entered twice. True if stored.
+bool hofRecord(const PartyMon &m, uint8_t how, uint32_t epoch);
+bool hofAppendRaw(const HofEntry &e);    // restore path
+bool hofClear();
