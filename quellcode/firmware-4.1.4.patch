+// Dennis build 4.0.12: display mode. Time stops, nothing is saved, it survives a
+// restart without catching up, the slideshow walks the Pokedex, and leaving it
+// carries on from where it was.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "i18n.h"
+#include <cstdio>
+#include <cstring>
+uint32_t g_seed=6; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+void vitEnter(); void vitExit(); void vitrineTap(int16_t x, int16_t y);
+int16_t vitNextDex(int16_t from); uint8_t vitBiome(int16_t dex);
+void clockTap(int16_t x, int16_t y);
+int uiSettingsRowCenterY(int i);
+extern Pet pet; extern Arduino_Canvas *gfx;
+extern bool vitrine, clockOpen; extern uint8_t clockPage; extern int16_t vitDex;
+extern uint32_t vitExitUntil;
+void emuSetTimeScale(uint32_t s);
+static void runFor(uint32_t ms) { uint32_t t0 = millis(); while (millis() - t0 < ms) loop(); }
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.dbgHatchAs(25, true);           // PIKACHU, shiny
+  pet.dbgHatchAs(6, false);           // live: GLURAK
+  pet.ageMinutes = 30UL * MINUTES_PER_LEVEL;
+  pet.saveNow();
+  gLang = LANG_DE;
+
+  {   // 4.1.2: random order, all of them before any repeats, never twice in a row
+    int cur = 0, repeats = 0, firsts[3] = {0, 0, 0}, count[3] = {0, 0, 0};
+    bool firstRoundFair = true;
+    for (int trial = 0; trial < 20; trial++) {          // fresh rounds: each starts the bag over
+      int a = vitNextDex(-1), b = vitNextDex(a), c = vitNextDex(b);
+      if (a == b || b == c || a == c) firstRoundFair = false;
+      firsts[a == 4 ? 0 : a == 6 ? 1 : 2]++;
+      cur = c;
+      for (int k = 0; k < 3; k++) vitNextDex(cur);      // empty whatever is left of the bag
+    }
+    for (int k = 0; k < 300; k++) {
+      int nx = vitNextDex(cur);
+      if (nx == cur) repeats++;
+      count[nx == 4 ? 0 : nx == 6 ? 1 : 2]++;
+      cur = nx;
+    }
+    printf("      first picks: GLUMANDA %d, GLURAK %d, PIKACHU %d / shown of 300: %d %d %d\n",
+           firsts[0], firsts[1], firsts[2], count[0], count[1], count[2]);
+    CHECK(firstRoundFair, "a round shows every registered species before any comes back");
+    CHECK(!repeats, "never the same one twice in a row");
+    CHECK(count[0] >= 80 && count[1] >= 80 && count[2] >= 80, "and over time each gets its fair share");
+    CHECK(firsts[0] && firsts[1] && firsts[2], "the order really is random (BISASAM-first is gone)");
+  }
+
+  // switched on from settings, page 2, last row
+  clockOpen = true; clockPage = 1;
+  clockTap(233, uiSettingsRowCenterY(5));
+  CHECK(vitrine && !clockOpen, "the settings row turns display mode on");
+
+  uint32_t age = pet.ageMinutes; uint8_t food = pet.fullness;
+  int writes0 = 1000000; nvsFailWritesAfter(writes0);
+  emuSetTimeScale(20000); runFor(50UL * 60000UL); emuSetTimeScale(1);   // 50 minutes
+  int used = writes0 - nvsWriteBudget(); nvsResumeWrites();
+  printf("      after 50 min: age %u->%u, food %u->%u, NVS writes %d\n", (unsigned)age, (unsigned)pet.ageMinutes, food, pet.fullness, used);
+  CHECK(pet.ageMinutes == age && pet.fullness == food, "nothing ages or drains while it shows");
+  CHECK(used == 0, "and nothing is written to the save");
+  CHECK(vitDex > 0, "a species is on show");
+  shot("vitrine.ppm");
+  // 4.1.4: the backdrop follows the creature on show
+  CHECK(vitBiome(4) == 3 && vitBiome(6) == 3, "GLUMANDA and GLURAK stand at the volcano");
+  CHECK(vitBiome(25) == 0 && vitBiome(7) == 1 && vitBiome(1) == 2, "PIKACHU on the meadow, SCHIGGY on the beach, BISASAM in the forest");
+  CHECK(vitBiome(0) == 0, "nothing on show: the meadow");
+
+  // a restart on the wall comes back into display mode, with no catch-up
+  Pet again; again.begin();
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  CHECK(vitrine && pet.ageMinutes == age, "after a restart it is still in display mode, nothing caught up");
+
+  // leaving it
+  vitrineTap(233, 233);
+  CHECK(vitExitUntil != 0 && vitrine, "a first tap only shows EXIT");
+  shot("vitrine_exit.ppm");
+  vitrineTap(233, 392 + 24);
+  CHECK(!vitrine, "EXIT leaves display mode");
+  emuSetTimeScale(20000); runFor(125000); emuSetTimeScale(1);
+  CHECK(pet.ageMinutes >= age + 1 && pet.ageMinutes <= age + 4, "time runs again from now, not from when it was paused");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
