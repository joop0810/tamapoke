+void btlAwardMoney(bool narrate) {
+  btlMoneyGot = 0;
+  if (btlLink) return;
+  uint32_t m = battleMoney(btlWild, btlHard, btlWild ? btlFoe.level : 0, btlWild ? (int8_t)-1 : btlTrainer);
