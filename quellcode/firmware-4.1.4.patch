+// ---- Dennis build: spaced saves ----------------------------------------------
+// Post-battle writes go out one at a time with a pause between them instead of
+// back to back: on the board, the only save failures ever logged followed a
+// burst of writes at the end of a fight.
+enum : uint8_t { SQ_PET = 1, SQ_PARTY = 2 };
+static uint8_t gSaveQueue = 0;
+static uint32_t gSaveQueueAt = 0;
+void saveQueue(uint8_t what) { gSaveQueue |= what; gSaveQueueAt = millis(); }
+
+// ---- Dennis build: display mode (Vitrine) -----------------------------------
+static bool vitLoad() {
+  Preferences p;
+  if (!p.begin("tamapoke", true)) return false;
+  bool v = p.getBool("vitr", false);
+  p.end();
+  return v;
+}
+static void vitStore(bool on) {
+  Preferences p;
+  if (!p.begin("tamapoke", false)) return;
+  if (on) p.putBool("vitr", true); else p.remove("vitr");
+  p.end();
+}
+void vitEnter() {
+  pet.saveNow();                 // everything up to this moment is kept
+  vitrine = true;
+  vitStore(true);
+  vitDex = 0; vitSince = 0; vitExitUntil = 0;
+  clockOpen = false; menuOpen = false;
+}
+void vitExit() {
+  vitrine = false;
+  vitStore(false);
+  vitPmd.unload();
+  pet.resumeAfterPause(millis(), rtcEpoch());   // the paused time is NOT applied
+  pet.saveNow();
+  lastInteract = millis();
+}
+// Dennis build 4.1.2: the slideshow draws at random -- a shuffle bag, so every
+// registered species (in the installed regions) shows once before any repeats,
+// and the one on screen never comes straight back. The bag is RAM only (one bit
+// per dex number); nothing about it is saved.
+static uint8_t vitShown[(DEX_COUNT + 8) / 8];
+static bool vitWasShown(int16_t d) { return vitShown[d >> 3] & (1u << (d & 7)); }
+static bool vitCandidate(int16_t d) {
+  return d >= 1 && d <= DEX_COUNT && pet.isRegistered(d) && regionAvailable(regionOfDex(d));
+}
+uint8_t vitBiome(int16_t dex) {
+  if (dex < 1 || dex > DEX_COUNT) return 0;
+  uint8_t b = DEX_TBL[dex].biome;
+  return b < 6 ? b : 0;
+}
+int16_t vitNextDex(int16_t from) {
+  for (int pass = 0; pass < 2; pass++) {
+    uint16_t left = 0;
+    for (uint8_t r = 0; r < GAL_REGIONS; r++) {
+      if (!regionAvailable(r)) continue;
+      for (int16_t d = REGIONS[r].lo; d <= REGIONS[r].hi && d <= DEX_COUNT; d++)
+        if (pet.isRegistered(d) && !vitWasShown(d) && d != from) left++;
+    }
+    if (left) {
+      uint16_t pick = (uint16_t)random(left);
+      for (uint8_t r = 0; r < GAL_REGIONS; r++) {
+        if (!regionAvailable(r)) continue;
+        for (int16_t d = REGIONS[r].lo; d <= REGIONS[r].hi && d <= DEX_COUNT; d++) {
+          if (!pet.isRegistered(d) || vitWasShown(d) || d == from) continue;
+          if (pick-- == 0) { vitShown[d >> 3] |= (uint8_t)(1u << (d & 7)); return d; }
+        }
+      }
+    }
+    // the bag is empty: refill it (the one on screen counts as already shown)
+    memset(vitShown, 0, sizeof(vitShown));
+    if (vitCandidate(from)) vitShown[from >> 3] |= (uint8_t)(1u << (from & 7));
+  }
+  return vitCandidate(from) ? from : 0;   // only one species registered (or none)
+}
+
+// Dennis build: everything you hold (party, box, a creature waiting for a
+// slot) and everything in the Hall of Fame counts as registered. Runs at every
+// boot; it only writes when something was missing, so after the first boot of
+// this build it is a no-op.
+void dexBackfillCaught() {
+  bool changed = false;
+  for (int i = 0; i < PARTY_SLOTS; i++)
+    if (party.slots[i].dex >= 1) changed |= pet.registerCaught(party.slots[i].dex, party.slots[i].shiny);
+  for (int i = 0; i < BOX_SLOTS; i++)
+    if (party.box[i].dex >= 1) changed |= pet.registerCaught(party.box[i].dex, party.box[i].shiny);
+  if (pet.endedKind != CER_NONE && pet.endedMon.dex >= 1)
+    changed |= pet.registerCaught(pet.endedMon.dex, pet.endedMon.shiny);
+  HofEntry e;
+  for (uint16_t i = 0; i < hofCount(); i++)
+    if (hofGet(i, e)) changed |= pet.registerCaught(e.dex, e.shiny);
+  if (changed) pet.saveNow();
+}
