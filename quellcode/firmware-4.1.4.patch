+#include <cstdio>
+#include <cstring>
+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+bool startWildBattle(uint8_t region, bool hard);
+bool bagUseOnPet(uint8_t k);
+extern Pet pet; extern Inventory bag; extern Arduino_Canvas *gfx;
+extern uint16_t squadMask; extern uint8_t btlMenu, btlMsgCount;
+extern Combatant btlFoe; extern int16_t wildDex;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+// counts red tag pixels in the foe plate's top-right corner
+static int tagPixels() {
+  render();
+  const uint16_t *fb = gfx->buffer(); int n = 0;
+  for (int y = 0; y < 200; y++) for (int x = 150; x < 466; x++) if (fb[y * 466 + x] == UI_BAR_BAD) n++;
+  return n;
+}
+int main() {
+  // ---- German UI words
+  gLang = LANG_EN;
+  CHECK(!strcmp(typeName(T_FIRE), "FIRE") && !strcmp(itemName(IT_POTION), "POTION") && !strcmp(trText("BROCK"), "BROCK"),
+        "English stays English");
+  gLang = LANG_DE;
+  CHECK(!strcmp(typeName(T_FIRE), "FEUER") && !strcmp(typeName(T_BUG), "KAEFER") && !strcmp(typeName(T_FAIRY), "FEE"),
+        "types are German: FEUER, KAEFER, FEE");
+  CHECK(!strcmp(itemName(IT_POKEBALL), "POKEBALL") && !strcmp(itemName(IT_GREATBALL), "SUPERBALL") &&
+        !strcmp(itemName(IT_POTION), "TRANK") && !strcmp(itemName(IT_FULLHEAL), "HYPERHEILER"),
+        "items are German: SUPERBALL, TRANK, HYPERHEILER");
+  CHECK(!strcmp(itemName(IT_RARECANDY), "SONDERBONBON"), "the new item is a SONDERBONBON");
+  CHECK(!strcmp(trText("BROCK"), "ROCKO") && !strcmp(trText("LT SURGE"), "MAJOR BOB") &&
+        !strcmp(trText("WHITNEY"), "BIANKA") && !strcmp(trText("PEWTER"), "MARMORIA") &&
+        !strcmp(trText("GOLDENROD"), "DUKATIA") && !strcmp(trText("ELITE 4"), "TOP VIER"),
+        "trainers and towns: ROCKO, MAJOR BOB, BIANKA, MARMORIA, DUKATIA, TOP VIER");
+  bool allKJ = true;
+  for (int r = 0; r < 2; r++) for (int i = 0; i < TRAINER_COUNT; i++) {
+    const Trainer &t = TRAINER_SETS[r].list[i];
+    for (const char *w : { trText(t.name), trText(t.place) })
+      for (const char *c = w; *c; c++) if (*c < 32 || *c > 126) allKJ = false;
+  }
+  CHECK(allKJ, "every Kanto/Johto trainer and town text is plain ASCII");
+  CHECK(!strcmp(trText("ROXANNE"), "ROXANNE"), "other regions keep their names");
+
+  // ---- wild levels
+  CHECK(wildLevelMax(1, false) == 1 && wildLevelMax(20, false) == 20 && wildLevelMin(20, false) == 15,
+        "normal: 5 below up to your own level, never above");
+  CHECK(wildLevelMax(20, true) == MAX_LEVEL, "hard still opens the whole ladder");
+
+  // ---- game: Rare Candy and the NEW tag
+  gLang = LANG_EN;
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.ageMinutes = 4UL * MINUTES_PER_LEVEL + 17;     // level 5, 17 min into it
+  gLang = LANG_DE;
+  bag.add(IT_RARECANDY, 2);
+  CHECK(itemUsableInField(IT_RARECANDY) && !itemUsableInBattle(IT_RARECANDY), "a candy is used from the field bag, not in a fight");
+  uint8_t before = pet.level();
+  CHECK(bagUseOnPet(IT_RARECANDY) && pet.level() == before + 1 && pet.ageMinutes % MINUTES_PER_LEVEL == 0,
+        "a candy lifts exactly to the start of the next level");
+  pet.ageMinutes = (uint32_t)(MAX_LEVEL - 1) * MINUTES_PER_LEVEL;
+  CHECK(!bagUseOnPet(IT_RARECANDY), "and is refused at level 100");
+  pet.ageMinutes = 9UL * MINUTES_PER_LEVEL;
+  uint32_t weight = 0; for (int k = 1; k < ITEM_COUNT; k++) weight += itemEntry(k).dropWeight;
+  printf("      candy drop chance per draw: %u/%u\n", itemEntry(IT_RARECANDY).dropWeight, (unsigned)weight);
+  CHECK(itemEntry(IT_RARECANDY).dropWeight > 0, "candies can drop from wild wins");
+
+  squadMask = 0x1;
+  CHECK(startWildBattle(0, false), "a wild encounter starts");
+  for (int i = 0; i < 6; i++) loop();
+  btlMsgCount = 0; btlMenu = 0;
+  int16_t dex = btlFoe.dex;
+  bool unseen = !pet.isRegistered(dex);
+  int tagNew = tagPixels();
+  shot("neu_tag.ppm");
+  pet.dbgHatchAs(dex, false); pet.dbgHatchAs(4, false);   // register that species
+  pet.ageMinutes = 9UL * MINUTES_PER_LEVEL;
+  int tagSeen = tagPixels();
+  printf("      foe %s, tag pixels unseen=%d seen=%d\n", speciesName(dex), tagNew, tagSeen);
+  CHECK(unseen && tagNew > tagSeen + 50, "an unseen wild species wears the NEU tag, a registered one does not");
+  CHECK(tagSeen > 20, "a registered one shows the small Poke Ball instead (4.0.10)");
+  shot("ball_tag.ppm");
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/dexcatch_test.cpp b/tools/emu/tests/dexcatch_test.cpp
new file mode 100644
index 00000000..1fc5f218
--- /dev/null
+++ b/tools/emu/tests/dexcatch_test.cpp
@@ -0,0 +1,81 @@
+// Dennis build 4.0.7: catching registers the species in the Pokedex, and the
+// first boot back-fills everything already held (party, box, Hall of Fame).
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "items.h"
+#include "inventory.h"
+#include "hof.h"
+#include "i18n.h"
+#include <cstdio>
+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop();
+void emuSetTimeScale(uint32_t s);
+bool startWildBattle(uint8_t region, bool hard);
+void battleTap(int16_t x, int16_t y);
+void dexBackfillCaught();
+extern Pet pet; extern Party party; extern Inventory bag;
+extern uint16_t squadMask; extern uint8_t btlMenu, btlBagPage, btlMsgCount;
+extern bool btlWild, wildCaught; extern Combatant btlFoe;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static PartyMon mon(int16_t dex, bool shiny) {
+  PartyMon m; m.dex = dex; m.level = 5; m.stateVersion = 1; m.ageMinutes = 4UL * MINUTES_PER_LEVEL; m.shiny = shiny;
+  return m;
+}
+int main() {
+  remove("hof.bin");
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.ageMinutes = 9UL * MINUTES_PER_LEVEL;
+
+  // ---- the back-fill: a 4.0.6 save holds creatures it never registered
+  for (int i = 0; i < PARTY_SLOTS; i++) party.releaseAt(i);
+  party.replaceAt(0, mon(16, false));          // TAUBSI in the team
+  party.boxAdd(mon(19, true));                 // a shiny RATTFATZ in the box
+  party.save();
+  hofRecord(mon(129, false), HOF_RELEASED, 0);  // a released KARPADOR
+  CHECK(!pet.isRegistered(16) && !pet.isRegistered(19) && !pet.isRegistered(129), "before: held creatures are not in the dex");
+  uint16_t before = pet.registeredCount();
+  dexBackfillCaught();
+  CHECK(pet.isRegistered(16) && pet.isRegistered(19) && pet.isRegistered(129), "after the back-fill: team, box and Hall of Fame are in");
+  CHECK(pet.isShinyRegistered(19) && !pet.isShinyRegistered(16), "a shiny catch is a shiny entry, a normal one is not");
+  CHECK(pet.registeredCount() == before + 3, "and nothing else was added");
+  Pet reread; reread.begin();
+  CHECK(reread.isRegistered(16) && reread.isRegistered(129), "the back-fill is saved");
+  dexBackfillCaught();
+  CHECK(pet.registeredCount() == before + 3, "a second boot changes nothing");
+
+  // ---- a real catch
+  for (int k = 1; k < ITEM_COUNT; k++) while (bag.count((ItemKey)k)) bag.consume((ItemKey)k);
+  bag.add(IT_MASTERBALL, 1);
+  squadMask = 0x1;
+  int16_t foe = 0;
+  for (int tries = 0; tries < 40; tries++) {
+    CHECK(startWildBattle(0, false), "a wild encounter starts");
+    for (int i = 0; i < 6; i++) loop();
+    if (!pet.isRegistered(btlFoe.dex)) { foe = btlFoe.dex; break; }
+  }
+  CHECK(foe > 0, "found a species not yet in the dex");
+  btlMsgCount = 0; btlMenu = 3; btlBagPage = 0;
+  battleTap(69 + 80, 270 + 27);
+  CHECK(wildCaught, "the Master Ball catches it");
+  CHECK(pet.isRegistered(foe), "the caught species is in the Pokedex straight away");
+  { uint32_t t0 = millis(); emuSetTimeScale(20); while (millis() - t0 < 1500) loop(); emuSetTimeScale(1); }   // the save queue (4.0.14)
+  Pet again; again.begin();
+  CHECK(again.isRegistered(foe), "and that is saved");
+  printf("      caught %s\n", speciesName(foe));
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/dimflash_test.cpp b/tools/emu/tests/dimflash_test.cpp
new file mode 100644
index 00000000..62b72419
--- /dev/null
+++ b/tools/emu/tests/dimflash_test.cpp
@@ -0,0 +1,36 @@
+// Dennis build 4.0.15: a tap registered after loop() took its `now` must not
+// make the panel think it has been idle for ~49 days and dim to near black.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include <cstdio>
+uint32_t g_seed=9; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop();
+void updateBrightness(uint32_t now);
+extern Pet pet; extern uint32_t lastInteract; extern uint8_t gBrightNow, dimStage;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  uint32_t now = millis();
+  lastInteract = now;
+  updateBrightness(now);
+  uint8_t lit = gBrightNow;
+  lastInteract = now + 7;          // the tap landed 7 ms after `now` was taken
+  updateBrightness(now);
+  printf("      lit %u, after a tap 7 ms later: %u (dimStage %u)\n", lit, gBrightNow, dimStage);
+  CHECK(dimStage == 0 && gBrightNow == lit, "a tap later in the same pass does not dim the panel");
+  lastInteract = now - 400000;     // genuinely idle for 400 s
+  updateBrightness(now);
+  CHECK(dimStage == 2 && gBrightNow < lit, "real idleness still dims it");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/exp_test.cpp b/tools/emu/tests/exp_test.cpp
new file mode 100644
index 00000000..275863e1
--- /dev/null
+++ b/tools/emu/tests/exp_test.cpp
@@ -0,0 +1,122 @@
+// Dennis build: battle experience. The formula, then the real award path on a
+// real squad: the live pet and a party member that fought gain growth, one that
+// sat on the bench does not, LAN never pays, and the party change is persisted.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "i18n.h"
+#include <cstdio>
+#include <cstring>
+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop();
+void emuSetTimeScale(uint32_t s);
+bool startWildBattle(uint8_t region, bool hard);
+void btlAwardExp(bool narrate);
+extern Pet pet; extern Party party;
+extern uint16_t squadMask;
+extern uint8_t btlSquadN, btlFought, btlRegion, btlMsgCount;
+extern int8_t btlSquadSrc[]; extern int8_t btlTrainer;
+extern bool btlWild, btlLink, btlHard;
+extern Combatant btlFoe;
+extern char btlMsg[6][40];
+extern char btlExpName[12]; extern uint16_t btlExpGot; extern bool btlExpLevelUp;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+
+int main() {
+  // ---- the formula
+  CHECK(battleExpMinutes(EXP_WILD, false, 5, 5) == 15, "an even wild fight is worth 15 EXP");
+  CHECK(battleExpMinutes(EXP_WILD, false, 10, 5) == 26, "five levels above you is worth 175 %");
+  CHECK(battleExpMinutes(EXP_WILD, false, 2, 30) == 1, "a far weaker foe is floored at 10 %, never 0");
+  CHECK(battleExpMinutes(EXP_WILD, false, 60, 5) == 37, "a far stronger foe is capped at 250 %");
+  CHECK(battleExpMinutes(EXP_GYM, false, 12, 12) == 20 && battleExpMinutes(EXP_ELITE, false, 50, 50) == 30,
+        "gym 20, Elite 4 / champion 30 per creature");
+  CHECK(battleExpMinutes(EXP_GYM, true, 12, 12) == 30, "hard mode is worth 1.5x");
+  CHECK(battleExpMinutes(EXP_WILD, false, 99, MAX_LEVEL) == 0, "level 100 gains nothing");
+
+  // ---- a real squad
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);                      // GLUMANDA
+  pet.ageMinutes = 4UL * MINUTES_PER_LEVEL;      // level 5
+  for (int i = 0; i < PARTY_SLOTS; i++) party.releaseAt(i);
+  PartyMon a; a.dex = 16; a.level = 5; a.stateVersion = 1; a.ageMinutes = 4UL * MINUTES_PER_LEVEL; party.replaceAt(0, a);
+  PartyMon b; b.dex = 19; b.level = 5; b.stateVersion = 1; b.ageMinutes = 4UL * MINUTES_PER_LEVEL; party.replaceAt(1, b);
+  party.save();
+  squadMask = 0x7;                               // pet + slot 0 + slot 1
+
+  CHECK(startWildBattle(0, false), "a Kanto encounter starts");
+  CHECK(btlSquadN == 3 && btlSquadSrc[0] == -1 && btlSquadSrc[1] == 0 && btlSquadSrc[2] == 1,
+        "the squad knows where each member came from");
+  btlFoe.level = 5;
+  btlFought = 0x3;                               // pet and slot 0 fought, slot 1 stayed on the bench
+  uint32_t petBefore = pet.ageMinutes;
+  uint32_t aBefore = party.slots[0].ageMinutes, bBefore = party.slots[1].ageMinutes;
+  btlMsgCount = 0;
+  btlAwardExp(true);
+  CHECK(pet.ageMinutes == petBefore + 15, "the live pet gains 15 minutes of growth");
+  CHECK(party.slots[0].ageMinutes == aBefore + 15, "the party member that fought gains it too");
+  CHECK(party.slots[1].ageMinutes == bBefore, "the one on the bench gains nothing");
+  CHECK(btlMsgCount == 2, "one line of narration per creature that gained");
+  printf("      \"%s\" / \"%s\"\n", btlMsg[0], btlMsg[1]);
+
+  // enough to level: a creature five levels up
+  btlFoe.level = 10;
+  btlFought = 0x2;
+  uint8_t lvBefore = (uint8_t)party.slots[0].level;
+  party.slots[0].ageMinutes = 4UL * MINUTES_PER_LEVEL + 50;   // 10 minutes short of level 6
+  btlMsgCount = 0;
+  btlAwardExp(true);
+  CHECK(party.slots[0].level == lvBefore + 1, "crossing the hour levels the stored creature up");
+  printf("      \"%s\"\n", btlMsg[0]);
+
+  // persisted -- by the save queue a moment later (4.0.14), not inline
+  { uint32_t t0 = millis(); emuSetTimeScale(20); while (millis() - t0 < 1500) loop(); emuSetTimeScale(1); }
+  uint32_t saved = party.slots[0].ageMinutes;
+  Party reread; reread.begin();
+  CHECK(reread.slots[0].ageMinutes == saved && reread.slots[0].level == party.slots[0].level,
+        "the party change is written to the save");
+
+  // a pre-care-state record: its age lives only in `level`
+  party.slots[1].stateVersion = 0; party.slots[1].ageMinutes = 0; party.slots[1].level = 20;
+  btlFoe.level = 20; btlFought = 0x4;
+  btlAwardExp(false);
+  CHECK(party.slots[1].level == 20 && party.slots[1].ageMinutes == 19UL * MINUTES_PER_LEVEL + 15,
+        "an old record grows from its level, not from zero");
+
+  // a gym win pays per creature in the leader's team
+  btlWild = false; btlTrainer = 0; btlRegion = 0; btlHard = false;   // Kanto, Brock
+  btlFought = 0x1;
+  petBefore = pet.ageMinutes;
+  btlExpName[0] = 0;
+  btlAwardExp(false);
+  CHECK(pet.ageMinutes > petBefore + 20, "Brock's whole team counts");
+  CHECK(btlExpName[0] && btlExpGot == pet.ageMinutes - petBefore, "the win screen gets the first creature's EXP");
+  printf("      Brock paid %u EXP at level %u\n", (unsigned)btlExpGot, pet.level());
+
+  // LAN never pays
+  btlLink = true; btlFought = 0x7;
+  petBefore = pet.ageMinutes;
+  btlAwardExp(true);
+  CHECK(pet.ageMinutes == petBefore, "a LAN fight gives no EXP");
+  btlLink = false;
+
+  // German text
+  gLang = LANG_DE;
+  btlWild = true; btlTrainer = -1; btlFoe.level = 5; btlFought = 0x1; btlMsgCount = 0;
+  btlAwardExp(true);
+  printf("      DE: \"%s\"\n", btlMsg[0]);
+  CHECK(strstr(btlMsg[0], "EP") || strstr(btlMsg[0], "Lv."), "German narration uses EP / Lv.");
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
