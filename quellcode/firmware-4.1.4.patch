 }
 
 uint8_t wildDropCount(bool hard, uint8_t bonusRoll) {
@@ -119,3 +121,45 @@ int16_t wildPickSpecies(uint8_t region, uint8_t tier, uint32_t roll) {
   }
   return 0;
 }
+
+uint16_t battleExpMinutes(uint8_t kind, bool hard, uint8_t foeLevel, uint8_t myLevel) {
+  if (myLevel >= MAX_LEVEL) return 0;
+  uint32_t base = kind == EXP_ELITE ? 30 : (kind == EXP_GYM ? 20 : 15);
+  if (hard) base = base * 3 / 2;
+  int pct = 100 + ((int)foeLevel - (int)myLevel) * 15;
+  if (pct < 10) pct = 10;
+  if (pct > 250) pct = 250;
+  uint32_t m = base * (uint32_t)pct / 100;
+  return (uint16_t)(m ? m : 1);
+}
+
+uint32_t battleMoney(bool wild, bool hard, uint8_t foeLevel, int8_t trainer) {
+  uint32_t m;
+  if (wild) m = 50u + foeLevel;
+  else if (trainer < 0) return 0;
+  else if (trainer < 8) m = 500u + 125u * (uint32_t)trainer;   // the eight gyms
+  else if (trainer < 12) m = 2000u;                             // Elite 4
+  else m = 3000u;                                               // champion
+  return hard ? m * 2 : m;
+}
+
+int16_t wildPickMissing(uint8_t region, uint8_t tier, uint32_t roll, bool (*have)(int16_t)) {
+  uint16_t lo = 1, hi = DEX_COUNT;
+  if (region < REGION_COUNT && region != REGION_ALL) { lo = REGIONS[region].lo; hi = REGIONS[region].hi; }
+  if (hi > DEX_COUNT) hi = DEX_COUNT;
+  uint16_t n = 0;
+  for (uint16_t d = lo; d <= hi; d++) {
+    if (DEX_TBL[d].rarity != tier || !speciesHasArt((int16_t)d)) continue;
+    if (!regionAvailable(regionOfDex((int16_t)d)) || have((int16_t)d)) continue;
+    n++;
+  }
+  if (!n) return 0;
+  uint16_t want = (uint16_t)(roll % n);
+  for (uint16_t d = lo; d <= hi; d++) {
+    if (DEX_TBL[d].rarity != tier || !speciesHasArt((int16_t)d)) continue;
+    if (!regionAvailable(regionOfDex((int16_t)d)) || have((int16_t)d)) continue;
+    if (!want) return (int16_t)d;
+    want--;
+  }
+  return 0;
+}
