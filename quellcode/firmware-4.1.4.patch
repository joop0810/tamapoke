+void vitrineTap(int16_t x, int16_t y) {
+  uint32_t now = millis();
+  if (vitExitUntil && now < vitExitUntil &&
+      x >= VIT_EXIT_X && x <= VIT_EXIT_X + VIT_EXIT_W && y >= VIT_EXIT_Y - 6 && y <= VIT_EXIT_Y + VIT_EXIT_H + 6) {
+    vitExitUntil = 0;
+    sfxPlay(SFX_TAP);
+    vitExit();
+    return;
+  }
+  vitExitUntil = now + 5000;   // first tap only offers the way out
+}
+
+void renderVitrine() {
+  uint32_t now = millis();
+  if (!vitDex || now - vitSince >= VIT_SLIDE_MS) {
+    int16_t nx = vitNextDex(vitDex);
+    vitSince = now;
+    if (nx != vitDex || !vitPmd.loaded) {
+      vitDex = nx;
+      vitPmd.unload();
+      if (vitDex > 0) vitPmd.load(vitDex, pet.isShinyRegistered(vitDex));
+    }
+  }
+  int h = sceneHour();
+  bool night = h < 6 || h >= 20;
+  // Dennis build 4.1.4: the backdrop is the shown creature's own habitat, the
+  // same one the home screen uses -- CHARMANDER at the volcano, SQUIRTLE on the
+  // beach. With nothing registered it falls back to the meadow.
+  uint8_t bi = vitBiome(vitDex);
+  drawScene(bi, now, night);                         // covers the whole panel
+  if (vitDex > 0) {
+    // a slow drift so no pixel of the creature sits still for long
+    int cx = CX + (int)(36.0f * sinf((float)(now % 60000UL) * 6.2831853f / 60000.0f));
+    if (vitPmd.loaded) drawPmdActM(vitPmd, PMD_IDLE, cx, PET_GROUND, now, true, false, 5);
+    else { const uint8_t *t = thumbs.get(vitDex); if (t) drawThumb(t, cx - 80, 170, 4, false); }
+    char nm[28];
+    snprintf(nm, sizeof(nm), "#%03d %s%s", vitDex, pet.isShinyRegistered(vitDex) ? "*" : "", speciesName(vitDex));
+    char cnt[20];
+    snprintf(cnt, sizeof(cnt), "%d/%d", dexShownGot(), dexShownTotal());
+    int py = 330 + (int)((now / VIT_SLIDE_MS) % 3) * 4;   // the plate moves a little too
