diff --git a/tools/gen_names_de.py b/tools/gen_names_de.py
new file mode 100644
index 00000000..accb40fb
--- /dev/null
+++ b/tools/gen_names_de.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Dennis build: writes dex_names_de.h, the German species names.
+
+Source: PokeAPI's species-name table (language 6 = German), e.g.
+  https://raw.githubusercontent.com/PokeAPI/pokeapi/master/data/v2/csv/pokemon_species_names.csv
+
+  python3 tools/gen_names_de.py pokemon_species_names.csv
+
+The panel font is ASCII only (see CLAUDE.md), so names are written the way the
+German UI strings already are: ae/oe/ue/ss, and the Nidoran symbols as W/M.
+Upper case, like DEX_TBL.
+"""
+import csv, os, re, sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+
+def translit(name):
+    name = name.replace('♀', ' W').replace('♂', ' M')
+    for a, b in (('ä', 'ae'), ('ö', 'oe'), ('ü', 'ue'), ('Ä', 'AE'), ('Ö', 'OE'),
+                 ('Ü', 'UE'), ('ß', 'ss'), ('é', 'e'), ('É', 'E')):
+        name = name.replace(a, b)
+    name = name.upper()
+    if not all(32 <= ord(c) < 127 for c in name):
+        sys.exit(f'non-ASCII left in {name!r}')
+    return name
+
+def main():
+    src = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, 'pokemon_species_names.csv')
+    dex_count = int(re.search(r'#define DEX_COUNT (\d+)', open(os.path.join(ROOT, 'dex.h')).read()).group(1))
+    names = {}
+    with open(src, encoding='utf-8') as f:
+        for row in csv.DictReader(f):
+            if row['local_language_id'] == '6':
+                names[int(row['pokemon_species_id'])] = translit(row['name'])
+    missing = [d for d in range(1, dex_count + 1) if d not in names]
+    if missing:
+        sys.exit(f'no German name for {missing[:10]}')
+    out = os.path.join(ROOT, 'dex_names_de.h')
+    with open(out, 'w') as f:
+        f.write('// GENERATED by tools/gen_names_de.py -- do not edit by hand.\n')
+        f.write('// German species names (PokeAPI, language 6), ASCII-transliterated.\n')
+        f.write('#pragma once\n\n')
+        f.write(f'static const char *const DEX_NAME_DE[{dex_count} + 1] = {{\n  "",\n')
+        for d in range(1, dex_count + 1):
+            f.write(f'  "{names[d]}",  // {d}\n')
+        f.write('};\n')
+    print(f'wrote {out}: {dex_count} names')
+
+if __name__ == '__main__':
+    main()
