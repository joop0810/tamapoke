diff --git a/tools/emu/tests/shiny_test.cpp b/tools/emu/tests/shiny_test.cpp
new file mode 100644
index 00000000..310a03d3
--- /dev/null
+++ b/tools/emu/tests/shiny_test.cpp
@@ -0,0 +1,86 @@
+// Dennis build 4.1.1: a wild shiny cannot be missed -- its own battle line, a
+// sparkle as it appears, a twinkle, and a yellow star on its name plate.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "items.h"
+#include "inventory.h"
+#include "i18n.h"
+#include "species.h"
+#include <cstdio>
+#include <cstring>
+uint32_t g_seed=5; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+bool startWildBattle(uint8_t region, bool hard);
+extern Pet pet; extern Arduino_Canvas *gfx;
+extern uint16_t squadMask; extern uint8_t btlMsgCount;
+extern Combatant btlFoe; extern int16_t wildDex; extern bool wildShiny, battleOpen;
+extern char btlMsg[6][40];
+extern uint32_t btlShinyUntil[2];
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+static long countColor(int x0, int y0, int x1, int y1, uint16_t col) {
+  const uint16_t *fb = gfx->buffer(); long n = 0;
+  for (int y = y0; y < y1; y++) for (int x = x0; x < x1; x++) if (fb[y * 466 + x] == col) n++;
+  return n;
+}
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.ageMinutes = 15UL * MINUTES_PER_LEVEL;
+  gLang = LANG_DE;
+  squadMask = 0x1;
+
+  // a normal encounter first
+  int tries = 0;
+  do { CHECK(startWildBattle(0, false) || true, "start"); tries++; } while (wildShiny && tries < 50);
+  CHECK(!wildShiny && strstr(btlMsg[0], "Ein wildes") && !btlShinyUntil[1], "a normal one: the usual line, no sparkle");
+  shot("shiny_normal.ppm");
+  long plainYellow = countColor(240, 20, 466, 200, UI_BAR_WARN);
+
+  // roll until a shiny turns up (1 in 4096)
+  tries = 0;
+  bool got = false;
+  while (tries < 60000) { tries++; startWildBattle(0, false); if (wildShiny) { got = true; break; } }
+  printf("      a shiny after %d encounters: %s\n", tries, speciesName(wildDex));
+  CHECK(got, "a shiny turns up");
+  CHECK(btlFoe.shiny, "the foe is shiny");
+  printf("      \"%s\"\n", btlMsg[0]);
+  CHECK(strstr(btlMsg[0], "schillerndes") != nullptr, "it gets its own line: Ein schillerndes ... erscheint!");
+  CHECK(btlShinyUntil[1] > millis(), "and a sparkle runs");
+  { uint32_t t0 = millis(); while (millis() - t0 < 500) loop(); }
+  shot("shiny_sparkle.ppm");
+  long sparkYellow = countColor(240, 20, 466, 200, UI_BAR_WARN);
+  printf("      yellow pixels around the foe: normal %ld, shiny %ld\n", plainYellow, sparkYellow);
+  CHECK(sparkYellow > plainYellow + 40, "the sparkle is drawn around the foe");
+  { uint32_t t0 = millis(); while (millis() - t0 < 2500) loop(); }
+  CHECK(millis() >= btlShinyUntil[1], "and fades out");
+  shot("shiny_after.ppm");
+  long starYellow = countColor(70, 70, 240, 95, UI_BAR_WARN);
+  CHECK(starYellow > 0, "the name plate keeps a yellow star");
+
+  // the other languages carry the line too
+  for (int l = 0; l < LANG_COUNT; l++) { gLang = (Lang)l; CHECK(T(S_WILD_SHINY)[0] && strstr(T(S_WILD_SHINY), "%s"), "translated"); }
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/shop_test.cpp b/tools/emu/tests/shop_test.cpp
new file mode 100644
index 00000000..9720fa86
--- /dev/null
+++ b/tools/emu/tests/shop_test.cpp
@@ -0,0 +1,140 @@
+// Dennis build 4.0.9: money, the shop in the bag, stacked ball drops, the Full
+// Restore, and the purse riding along in the save backup.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "items.h"
+#include "inventory.h"
+#include "save.h"
+#include "i18n.h"
+#include <cstdio>
+#include <cstring>
+#include <vector>
+uint32_t g_seed=4; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+bool startWildBattle(uint8_t region, bool hard);
+void battleTap(int16_t x, int16_t y);
+void bagTap(int16_t x, int16_t y);
+bool shopBuy(uint8_t i);
+void btlAwardMoney(bool narrate);
+extern Pet pet; extern Inventory bag; extern Arduino_Canvas *gfx;
+extern uint16_t squadMask; extern uint8_t btlMenu, btlBagPage, btlMsgCount;
+extern bool btlWild, btlHard, wildCaught, bagOpen, shopMode; extern Combatant btlFoe, btlYou;
+extern uint32_t btlMoneyGot; extern int8_t btlTrainer;
+extern char btlMsg[6][40];
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+int main() {
+  // ---- the formula and the tables
+  CHECK(battleMoney(true, false, 1, -1) == 51 && battleMoney(true, false, 100, -1) == 150, "wild pays 51-150 by level");
+  CHECK(battleMoney(false, false, 0, 0) == 500 && battleMoney(false, false, 0, 7) == 1375, "gyms pay 500-1375");
+  CHECK(battleMoney(false, false, 0, 9) == 2000 && battleMoney(false, false, 0, 12) == 3000, "Elite 4 2000, champion 3000");
+  CHECK(battleMoney(true, true, 20, -1) == 140, "hard pays double");
+  CHECK(itemEntry(IT_POTION).dropWeight == 0 && itemEntry(IT_SUPERPOTION).dropWeight == 0 &&
+        itemEntry(IT_HYPERPOTION).dropWeight == 0 && itemEntry(IT_FULLHEAL).dropWeight == 0,
+        "the four small heals no longer drop");
+  uint32_t total = 0, balls = 0;
+  for (int k = 1; k < ITEM_COUNT; k++) { total += itemEntry(k).dropWeight; if (itemIsBall(k)) balls += itemEntry(k).dropWeight; }
+  printf("      balls %u of %u weight (%u %%)\n", (unsigned)balls, (unsigned)total, (unsigned)(balls * 100 / total));
+  CHECK(balls * 100 / total >= 65, "about 70 % of drops are balls");
+  bool stacks = true;
+  for (int r = 0; r < 256; r++) {
+    uint8_t p = itemDropStack(IT_POKEBALL, r), g = itemDropStack(IT_GREATBALL, r), u = itemDropStack(IT_ULTRABALL, r);
+    if (p < 3 || p > 5 || g < 2 || g > 3 || u < 1 || u > 2 || itemDropStack(IT_MASTERBALL, r) != 1) stacks = false;
+  }
+  CHECK(stacks, "balls drop in stacks: 3-5 / 2-3 / 1-2, the Master Ball alone");
+
+  // ---- a save from 4.0.8 gets the welcome purse
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(4, false);
+  pet.ageMinutes = 15UL * MINUTES_PER_LEVEL;
+  CHECK(bag.cash() == CASH_WELCOME, "a save without money starts with the welcome sum");
+  Inventory again; again.begin();
+  CHECK(again.cash() == CASH_WELCOME, "and it is written, so it is not granted twice");
+
+  // ---- a wild win
+  gLang = LANG_DE;
+  squadMask = 0x1;
+  CHECK(startWildBattle(0, false), "a wild encounter starts");
+  for (int i = 0; i < 6; i++) loop();
+  uint32_t before = bag.cash();
+  btlMsgCount = 0;
+  btlAwardMoney(true);
+  CHECK(btlMoneyGot == 50u + btlFoe.level && bag.cash() == before + btlMoneyGot, "a wild win pays 50 + its level");
+  CHECK(btlMsgCount == 1 && strstr(btlMsg[0], "P$"), "and says so");
+  printf("      \"%s\"\n", btlMsg[0]);
+
+  // ---- the Full Restore
+  bag.add(IT_FULLRESTORE, 1);
+  btlYou.hp = 1; btlYou.ailment = AIL_PARA;
+  uint8_t idx = 0;
+  for (uint8_t i = 0, shown = 0; i < bag.distinctCount(); i++) {
+    ItemKey k = bag.keyAt(i);
+    if (!itemUsableInBattle(k)) continue;
+    if (k == IT_FULLRESTORE) { idx = shown; break; }
+    shown++;
+  }
+  btlMenu = 3; btlBagPage = idx / 4; btlMsgCount = 0;
+  int cell = idx % 4;
+  battleTap(69 + (cell % 2) * 168 + 80, 270 + (cell / 2) * 62 + 27);
+  printf("      after: hp %u/%u ail %u msgs %u: %s / %s\n", btlYou.hp, btlYou.maxHp, btlYou.ailment, btlMsgCount, btlMsg[0], btlMsg[1]);
+  // the foe acts after the item (it costs the turn), so HP is full minus one hit
+  CHECK(btlYou.hp > btlYou.maxHp / 2 && btlYou.ailment == AIL_NONE && !bag.has(IT_FULLRESTORE) && strstr(btlMsg[0], "TOP-GENESUNG"),
+        "the Full Restore fills HP and clears the ailment");
+  CHECK(!strcmp(itemName(IT_FULLRESTORE), "TOP-GENESUNG"), "it is a TOP-GENESUNG in German");
+
+  // ---- the shop
+  while (bag.cash()) bag.spendCash(bag.cash());
+  bag.addCash(1000);
+  uint8_t balls0 = bag.count(IT_POKEBALL);
+  CHECK(shopBuy(0) && bag.cash() == 800 && bag.count(IT_POKEBALL) == balls0 + 1, "a Poke Ball costs 200");
+  CHECK(!shopBuy(2) && bag.cash() == 800, "an Ultra Ball at 1200 is refused with 800");
+  bag.add(IT_GREATBALL, 99);
+  CHECK(!shopBuy(1) && bag.cash() == 800, "a full stack is refused, nothing spent");
+  Inventory reread; reread.begin();
+  CHECK(reread.cash() == 800, "the purse is saved");
+  bag.addCash(5000000);
+  CHECK(bag.cash() == CASH_MAX, "the purse caps at 999999");
+
+  // ---- the backup carries it
+  std::vector<uint8_t> buf(SAVE_TRANSFER_MAX);   // what the console EXPORT uses
+  size_t n = saveExport(buf.data(), buf.size());
+  bool hasCash = false;
+  for (size_t i = 0; i + 5 < n; i++) if (buf[i] == 4 && !memcmp(&buf[i + 1], "cash", 4)) hasCash = true;
+  printf("      export %u bytes of %u\n", (unsigned)n, (unsigned)buf.size());
+  CHECK(n && hasCash, "Back up save includes the money");
+
+  // ---- screens
+  btlWild = false;
+  bagOpen = true; shopMode = false;
+  shot("shop_bag.ppm");
+  bagTap(233, 82);
+  CHECK(shopMode, "the purse pill opens the shop");
+  shot("shop_shop.ppm");
+  bagTap(233, 82);
+  CHECK(!shopMode, "and goes back to the bag");
+  bagOpen = false;
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/tidy_test.cpp b/tools/emu/tests/tidy_test.cpp
