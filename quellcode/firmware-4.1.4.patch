+    if (th) drawThumb(th, 64 - 6, y - 5, 1, false);
+    char nm[20];
+    snprintf(nm, sizeof(nm), "%s%s", e.nick[0] ? e.nick : speciesName(e.dex), e.shiny ? "*" : "");
+    gfx->setTextColor(UI_INK);
+    gfx->setTextSize(2);
+    gfx->setCursor(142, y + 12);
+    gfx->print(nm);
+    char l[48], dt[12];
+    hofDate(e.when, dt, sizeof(dt));
+    snprintf(l, sizeof(l), "Lv.%u  %s  %s", e.level,
+             T(e.how == HOF_FAREWELL ? S_HOF_FAREWELL : S_HOF_RELEASED), dt);
+    gfx->setTextColor(UI_INK_SOFT);
+    gfx->setTextSize(1);
+    gfx->setCursor(142, y + 40);
+    gfx->print(l);
+  }
+  gfx->setTextColor(UI_INK_SOFT);
+  gfx->setTextSize(2);
+  gfx->setCursor(CX - strlen(T(S_BACK)) * 6, 392);
+  gfx->print(T(S_BACK));
+  uiChrome();
+  gfx->flush();
+}
