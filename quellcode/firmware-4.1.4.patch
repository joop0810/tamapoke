diff --git a/tools/emu/tests/hof_test.cpp b/tools/emu/tests/hof_test.cpp
new file mode 100644
index 00000000..f0b54dcf
--- /dev/null
+++ b/tools/emu/tests/hof_test.cpp
@@ -0,0 +1,126 @@
+// Dennis build: the Hall of Fame -- storage, the dedupe of a released farewell,
+// the let-go path, the Pokedex chooser row, and the HOF LIST / CLEAR / ADD
+// console round trip the local tool's backup relies on.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "hof.h"
+#include "i18n.h"
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <unistd.h>
+uint32_t g_seed=5; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+static std::vector<std::string> gIn;
+static size_t gAt = 0;
+int FakeSerial::available(){ return gAt < gIn.size() ? 1 : 0; }
+String FakeSerial::readStringUntil(char){ if (gAt >= gIn.size()) return String(""); return String(gIn[gAt++].c_str()); }
+void FakeESP::restart(){}
+void setup(); void loop(); void render(); void handleSerial();
+void letEndedGo();
+uint8_t rpickRegions(uint8_t mode);
+uint8_t rpickPageCount(uint8_t mode);
+extern Pet pet; extern Arduino_Canvas *gfx; extern uint16_t gRegionArt;
+extern bool galleryOpen, galleryPick, hofView; extern uint8_t hofPage, rpickPage;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static std::string runConsole(const std::vector<std::string> &lines) {
+  gIn = lines; gAt = 0;
+  char path[] = "/tmp/tamapoke_hof_XXXXXX";
+  int fd = mkstemp(path);
+  fflush(stdout);
+  int saved = dup(fileno(stdout));
+  dup2(fd, fileno(stdout));
+  while (gAt < gIn.size()) handleSerial();
+  fflush(stdout);
+  dup2(saved, fileno(stdout)); close(saved);
+  lseek(fd, 0, SEEK_SET);
+  std::string out; char b[4096]; ssize_t n;
+  while ((n = read(fd, b, sizeof(b))) > 0) out.append(b, (size_t)n);
+  close(fd); remove(path);
+  return out;
+}
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+static PartyMon mon(int16_t dex, uint8_t lvl, const char *nick, uint8_t iv) {
+  PartyMon m; m.dex = dex; m.level = lvl; m.ivAtk = iv; m.ivDef = iv + 1; m.ivSpe = iv + 2; m.ivHp = iv + 3;
+  snprintf(m.nick, sizeof(m.nick), "%s", nick); return m;
+}
+
+int main() {
+  remove("hof.bin");
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(6, false);
+  CHECK(hofReady() && hofCount() == 0, "a fresh board starts with an empty Hall of Fame");
+
+  PartyMon glurak = mon(6, 73, "FLAMMI", 20);
+  CHECK(hofRecord(glurak, HOF_FAREWELL, 1790000000UL), "a farewell is recorded");
+  CHECK(!hofRecord(glurak, HOF_RELEASED, 1790100000UL), "releasing the same creature later is not a second entry");
+  PartyMon rattfratz = mon(19, 12, "", 9);
+  CHECK(hofRecord(rattfratz, HOF_RELEASED, 1790200000UL), "a different creature let go is recorded");
+  CHECK(hofCount() == 2, "two entries");
+  HofEntry e;
+  CHECK(hofGet(0, e) && e.dex == 6 && e.level == 73 && e.how == HOF_FAREWELL && !strcmp(e.nick, "FLAMMI") && e.when == 1790000000UL,
+        "the record keeps species, level, kind, nickname and date");
+
+  // survives a "reboot"
+  hofBegin();
+  CHECK(hofCount() == 2, "it survives a restart");
+
+  // the let-go path: a newcomer that gets no slot
+  pet.setEnded(mon(16, 5, "", 11), CER_RELEASE);
+  uint16_t before = hofCount();
+  letEndedGo();
+  CHECK(hofCount() == before + 1 && pet.endedKind == CER_NONE, "a newcomer let go enters the Hall of Fame");
+
+  // console round trip, as the local tool does it
+  std::string out = runConsole({"HOF LIST"});
+  std::vector<std::string> recs;
+  size_t at = 0;
+  while (at < out.size()) { size_t nl = out.find('\n', at); if (nl == std::string::npos) nl = out.size();
+    std::string ln = out.substr(at, nl - at); if (ln.rfind("HOF ", 0) == 0) recs.push_back(ln); at = nl + 1; }
+  CHECK(recs.size() == hofCount() && out.find("DONE") != std::string::npos, "HOF LIST prints every record, then DONE");
+  CHECK(recs.size() && recs[0].size() == 4 + 64, "one 32-byte record per line, as hex");
+  uint16_t had = hofCount();
+  out = runConsole({"HOF CLEAR"});
+  CHECK(out.find("DONE") != std::string::npos && hofCount() == 0, "HOF CLEAR empties it");
+  std::vector<std::string> adds;
+  for (auto &r : recs) adds.push_back("HOF ADD " + r.substr(4));
+  out = runConsole(adds);
+  CHECK(hofCount() == had, "HOF ADD restores every record");
+  CHECK(hofGet(0, e) && !strcmp(e.nick, "FLAMMI"), "and the content comes back intact");
+  out = runConsole({"HOF ADD 1234"});
+  CHECK(out.find("ERR") != std::string::npos && hofCount() == had, "a malformed line is refused");
+
+  // the Pokedex chooser gains a row; Kanto + Johto installed
+  gRegionArt = 0b11;
+  CHECK(rpickRegions(1) == 2 && rpickPageCount(1) == 1, "two regions + the Hall of Fame row still fit one page");
+  gRegionArt = 0x1FF;   // all nine regions installed
+  CHECK(rpickRegions(1) == 9 && rpickPageCount(1) == 4, "nine regions + the Hall of Fame row page as 3+3+3+1");
+  rpickPage = 3; galleryOpen = true; galleryPick = true; hofView = false; gLang = LANG_DE;
+  shot("hof_pick9.ppm");
+  gRegionArt = 0b11;
+  gLang = LANG_DE;
+  galleryOpen = true; galleryPick = true; rpickPage = 0; hofView = false;
+  shot("hof_pick.ppm");
+  galleryPick = false; hofView = true; hofPage = 0;
+  shot("hof_page.ppm");
+  galleryOpen = false; hofView = false;
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
