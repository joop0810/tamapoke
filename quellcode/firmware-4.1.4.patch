+  for (uint8_t i = 0; i < n; i++) {
+    if (pet.isRegistered(mem[i])) h++;
+    else if (!miss) miss = mem[i];
+  }
+  if (have) *have = h;
+  if (missing) *missing = miss;
+  return n;
