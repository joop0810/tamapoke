+    gfx->setCursor(CX - (int)strlen(T(S_VIT_EMPTY)) * 6, CY);
+    gfx->print(T(S_VIT_EMPTY));
+  }
+  if (vitExitUntil && now < vitExitUntil) {
+    gfx->fillRoundRect(VIT_EXIT_X, VIT_EXIT_Y, VIT_EXIT_W, VIT_EXIT_H, 14, UI_BAR_BAD);
+    gfx->drawRoundRect(VIT_EXIT_X, VIT_EXIT_Y, VIT_EXIT_W, VIT_EXIT_H, 14, UI_INK);
+    gfx->setTextColor(UI_WHITE);
+    gfx->setTextSize(2);
+    gfx->setCursor(CX - (int)strlen(T(S_VIT_EXIT)) * 6, VIT_EXIT_Y + 16);
