+#include <cstdlib>
+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render(); void onSwipeV(int dir);
+extern Pet pet; extern uint16_t gRegionArt; extern Arduino_Canvas *gfx;
+extern bool galleryOpen, galleryPick, gymOpen, gymPick; extern bool galleryDirty;
+extern uint8_t galleryRegion, rpickPage; extern uint8_t galleryDetail;
+uint8_t rpickRegions(uint8_t mode);
+uint8_t rpickRegionAt(uint8_t mode, uint8_t k);
+enum { GYMS = 0, DEX = 1, START = 2 };
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) {
+    uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f);
+  }
+  fclose(f);
+}
+
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  if (pet.isEgg()) pet.dbgHatchAs(6, false);
+
+  gRegionArt = 0b11;                                  // Kanto + Johto only
+  CHECK(rpickRegions(DEX) == 2, "Pokedex chooser lists exactly Kanto and Johto");
+  CHECK(rpickRegionAt(DEX, 0) == 0 && rpickRegionAt(DEX, 1) == 1, "in order, row 0 Kanto, row 1 Johto");
+  CHECK(rpickRegions(START) == 2, "the starter chooser too");
+  CHECK(rpickRegions(GYMS) == 2, "and the gym chooser hides gyms of missing regions");
+
+  gRegionArt = 0b101;                                 // Kanto + Hoenn: a gap
+  CHECK(rpickRegions(DEX) == 2 && rpickRegionAt(DEX, 1) == 2, "a gap is compacted: row 1 is Hoenn");
+
+  gRegionArt = 0;                                     // card with no packs at all
+  CHECK(rpickRegions(DEX) == REGION_COUNT - 1 && rpickRegionAt(DEX, 3) == 3, "no pack anywhere: all listed (greyed), as before");
+
+  gRegionArt = 0xFFFF;                                // no SD / everything installed
+  CHECK(rpickRegions(DEX) == REGION_COUNT - 1, "everything installed: all nine listed");
+
+  // gallery vertical swipe skips missing regions
+  gRegionArt = 0b11;
+  galleryOpen = true; galleryPick = false; galleryDetail = 0; galleryRegion = 0;
+  onSwipeV(-1); uint8_t a = galleryRegion; onSwipeV(-1); uint8_t b = galleryRegion;
+  onSwipeV(-1); uint8_t c = galleryRegion;
+  printf("      swipes: %u -> %u -> %u\n", a, b, c);
+  CHECK(a <= 1 && b <= 1 && c <= 1 && a != b, "gallery swipe only visits Kanto and Johto");
+  galleryOpen = false;
+
+  for (int d = 1; d <= 200; d++) pet.dbgHatchAs(d, false);
+  galleryOpen = true; galleryPick = true; rpickPage = 0; galleryDirty = true;
+  shot("dexpick_kj.ppm");
+  galleryOpen = galleryPick = false;
+  gymOpen = true; gymPick = true; rpickPage = 0;
+  shot("gympick_kj.ppm");
+  gRegionArt = 0xFFFF; shot("gympick_all.ppm");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
