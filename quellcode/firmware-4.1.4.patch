+// Dennis build: the Hall of Fame page. Four creatures a page, newest first.
+static void hofDate(uint32_t epoch, char *out, size_t n) {
+  if (!epoch) { snprintf(out, n, "--.--.----"); return; }
+  int32_t z = (int32_t)(epoch / 86400) + 719468;          // civil-from-days
+  int32_t era = z / 146097, doe = z - era * 146097;
+  int32_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  int32_t y = yoe + era * 400, doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  int32_t mp = (5 * doy + 2) / 153, d = doy - (153 * mp + 2) / 5 + 1, m = mp < 10 ? mp + 3 : mp - 9;
+  if (m <= 2) y++;
+  snprintf(out, n, "%02d.%02d.%04d", (int)d, (int)m, (int)y);
+}
+
+// ---- Dennis build: the display mode's screen -------------------------
+#define VIT_EXIT_X (CX - 90)
+#define VIT_EXIT_Y 392
+#define VIT_EXIT_W 180
