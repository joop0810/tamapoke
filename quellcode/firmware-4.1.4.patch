+  gfx->fillCircle(CX, CY, 231, UI_BG_DAY);
+  uint16_t n = hofCount();
+  uint8_t pages = hofPages();
+  if (hofPage >= pages) hofPage = pages - 1;
+  char head[32];
+  snprintf(head, sizeof(head), "%s  %u", T(S_HOF), (unsigned)n);
+  gfx->setTextColor(UI_INK);
+  gfx->setTextSize(2);
+  gfx->setCursor(CX - (int)strlen(head) * 6, 44);
+  gfx->print(head);
+  if (!n) {
+    gfx->setTextColor(UI_INK_SOFT);
+    gfx->setTextSize(2);
+    gfx->setCursor(CX - (int)strlen(T(S_HOF_EMPTY)) * 6, 220);
+    gfx->print(T(S_HOF_EMPTY));
+  }
+  for (uint8_t r = 0; r < HOF_PER_PAGE; r++) {
+    uint16_t k = (uint16_t)(hofPage * HOF_PER_PAGE + r);
+    if (k >= n) break;
+    HofEntry e;
+    if (!hofGet((uint16_t)(n - 1 - k), e)) continue;     // newest first
+    int y = 74 + r * 76;
+    gfx->fillRoundRect(64, y, 338, 70, 12, UI_WHITE);
+    gfx->drawRoundRect(64, y, 338, 70, 12, e.how == HOF_FAREWELL ? UI_BAR_OK : UI_TRACK);
