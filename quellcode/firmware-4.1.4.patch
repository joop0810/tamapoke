+++ b/tools/emu/tests/tidy_test.cpp
@@ -0,0 +1,178 @@
+// Dennis build 4.0.13: selling in the shop (one write per visit), the box's
+// line ticks + TIDY UP, and the Lure.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "items.h"
+#include "inventory.h"
+#include "hof.h"
+#include "i18n.h"
+#include <cstdio>
+#include <cstring>
+uint32_t g_seed=8; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+bool startWildBattle(uint8_t region, bool hard);
+void bagTap(int16_t x, int16_t y);
+bool bagUseOnPet(uint8_t k);
+bool shopSellOne(uint8_t k);
+uint8_t lineStats(int16_t dex, uint8_t *have, int16_t *missing);
+uint8_t cleanupMarks(uint8_t *mark);
+uint8_t cleanupRun();
+int16_t lineBase(int16_t dex);
+extern Pet pet; extern Party party; extern Inventory bag; extern Arduino_Canvas *gfx;
+extern bool bagOpen, shopMode, shopSell, boxOpen, partyOpen, exploreOpen; extern uint8_t boxPage, bagPage;
+extern int16_t wildDex; extern bool battleOpen;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+static PartyMon mon(int16_t dex, uint8_t lvl, bool shiny = false) {
+  PartyMon m; m.dex = dex; m.level = lvl; m.stateVersion = 1; m.ageMinutes = (uint32_t)(lvl - 1) * 60; m.shiny = shiny; return m;
+}
+int main() {
+  remove("hof.bin");
+  // ---- prices
+  CHECK(itemSellPrice(IT_POKEBALL) == 100 && itemSellPrice(IT_ULTRABALL) == 600 && itemSellPrice(IT_MASTERBALL) == 0,
+        "selling pays half, the Master Ball cannot be sold");
+  CHECK(itemSellPrice(IT_RARECANDY) * 2 == 5000 && itemSellPrice(IT_FULLRESTORE) * 2 == 1500 && itemSellPrice(IT_LURE) * 2 == 1000,
+        "every shop ware sells back for exactly half what it costs");
+
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(1, false); pet.dbgHatchAs(2, false); pet.dbgHatchAs(3, false);   // BISASAM line complete
+  pet.dbgHatchAs(4, false);                                                        // GLUMANDA only
+  pet.dbgHatchAs(19, false);                                                       // RATTFRATZ only
+  pet.dbgHatchAs(25, false);   // live: PIKACHU
+  pet.ageMinutes = 20UL * MINUTES_PER_LEVEL;
+  pet.saveNow();
+  gLang = LANG_DE;
+
+  // ---- lines
+  uint8_t have = 0; int16_t miss = 0;
+  CHECK(lineBase(3) == 1 && lineBase(134) == 133, "the line base: BISAFLOR -> BISASAM, AQUANA -> EVOLI");
+  CHECK(lineStats(2, &have, &miss) == 3 && have == 3, "BISASAM's line is complete");
+  CHECK(lineStats(4, &have, &miss) == 3 && have == 1 && miss == 5, "GLUMANDA's line: 1 of 3, GLUTEXO missing");
+
+  // ---- the box: what TIDY UP takes
+  for (int i = 0; i < PARTY_SLOTS; i++) party.slots[i] = PartyMon();
+  for (int i = 0; i < BOX_SLOTS; i++) party.box[i] = PartyMon();
+  party.slots[0] = mon(19, 30);          // team: RATTFRATZ Lv30
+  party.box[0] = mon(1, 10);             // complete line -> goes
+  party.box[1] = mon(2, 20, true);       // complete line but SHINY -> stays
+  party.box[2] = mon(4, 12);             // GLUMANDA, line open, only one -> stays
+  party.box[3] = mon(4, 8);              // weaker GLUMANDA duplicate -> goes
+  party.box[4] = mon(19, 5);             // RATTFRATZ, the team has a stronger one -> goes
+  party.box[5] = mon(25, 40);            // PIKACHU duplicate of the live one -> goes
+  party.save();
+  uint8_t mark[BOX_SLOTS];
+  uint8_t n = cleanupMarks(mark);
+  printf("      marks: %u %u %u %u %u %u\n", mark[0], mark[1], mark[2], mark[3], mark[4], mark[5]);
+  CHECK(mark[0] == 1 && !mark[1] && !mark[2] && mark[3] == 2 && mark[4] == 2 && mark[5] == 2 && n == 4,
+        "complete line ticked, shiny and the last of an open line kept, weaker duplicates ticked");
+  boxOpen = true; partyOpen = true; boxPage = 0;
+  shot("tidy_box.ppm");
+  boxOpen = false; partyOpen = false;
+
+  uint16_t hof0 = hofCount();
+  int budget = 1000000; nvsFailWritesAfter(budget);
+  CHECK(cleanupRun() == 4, "TIDY UP takes the four");
+  int writes = budget - nvsWriteBudget(); nvsResumeWrites();
+  printf("      NVS writes for the whole tidy-up: %d\n", writes);
+  CHECK(hofCount() == hof0 + 4, "all four are in the Hall of Fame");
+  CHECK(party.box[0].empty() && !party.box[1].empty() && !party.box[2].empty() && party.box[3].empty() &&
+        party.box[4].empty() && party.box[5].empty(), "and their slots are free");
+  CHECK(writes <= 2, "the box is written once, not once per creature");
+  Party reread; reread.begin();
+  CHECK(reread.box[0].empty() && !reread.box[2].empty(), "the tidy box is saved");
+
+  // ---- selling: one write per shop visit
+  for (int k = 1; k < ITEM_COUNT; k++) while (bag.count((ItemKey)k)) bag.consume((ItemKey)k);
+  bag.add(IT_POKEBALL, 12); bag.add(IT_POTION, 2); bag.add(IT_MASTERBALL, 1);
+  uint32_t cash0 = bag.cash();
+  bagOpen = true; shopMode = false;
+  budget = 1000000; nvsFailWritesAfter(budget);
+  bagTap(233, 82);                        // into the shop
+  bagTap(233, 40);                        // the title: SELL
+  CHECK(shopMode && shopSell, "the title switches the shop to SELL");
+  shot("tidy_sell.ppm");
+  for (int i = 0; i < 12; i++) shopSellOne(IT_POKEBALL);
+  int during = budget - nvsWriteBudget();
+  CHECK(!shopSellOne(IT_MASTERBALL) && bag.count(IT_MASTERBALL) == 1, "the Master Ball is refused");
+  CHECK(bag.cash() == cash0 + 1200 && !bag.count(IT_POKEBALL), "twelve Poke Balls sell for 1200");
+  bagTap(233, 82);                        // back to the bag: the visit ends
+  int after = budget - nvsWriteBudget(); nvsResumeWrites();
+  printf("      NVS writes: %d while selling, %d after leaving\n", during, after);
+  CHECK(during == 0 && after > 0 && after <= 2, "nothing is written while selling, bag and purse once on leaving");
+  Inventory again; again.begin();
+  CHECK(again.cash() == cash0 + 1200 && !again.count(IT_POKEBALL), "and that is what was saved");
+  bagOpen = false;
+
+  // ---- the Lure
+  bag.add(IT_LURE, 1);
+  CHECK(itemUsableInField(IT_LURE) && !itemUsableInBattle(IT_LURE), "the Lure is used from the field bag");
+  CHECK(bagUseOnPet(IT_LURE) && bag.lureLeft() == 10, "using it gives 10 encounters");
+  bag.consume(IT_LURE);
+  int fresh = 0;
+  for (int i = 0; i < 10; i++) {
+    CHECK(startWildBattle(0, false), "an encounter starts");
+    if (!pet.isRegistered(wildDex)) fresh++;
+  }
+  printf("      with the Lure: %d of 10 encounters were missing species\n", fresh);
+  CHECK(fresh == 10 && bag.lureLeft() == 0, "every lured encounter is a missing species, and the 10 are spent");
+  Inventory reload; reload.begin();
+  CHECK(reload.lureLeft() == 0, "the spent Lure is saved");
+  bag.addLure(10);
+  battleOpen = false; exploreOpen = true; shot("tidy_explore.ppm"); exploreOpen = false;
+
+  // ---- Dennis build 4.1.2: only a legendary is missing
+  // The Lure used to find nothing here and spend a charge on an ordinary
+  // encounter. Now it lifts the missing legendary to ~10% (from 1% x 1/5).
+  {
+    for (int16_t d = 1; d <= 150; d++) pet.dexReg[(d - 1) >> 3] |= 1 << ((d - 1) & 7);
+    pet.dexReg[(151 - 1) >> 3] &= ~(1 << ((151 - 1) & 7));
+    CHECK(!pet.isRegistered(151) && pet.isRegistered(150), "fixture: all of Kanto but MEW");
+    int mew = 0, otherLegend = 0; const int N = 2000;
+    for (int i = 0; i < N; i++) {
+      if (!bag.lureLeft()) bag.addLure(10);
+      startWildBattle(0, false); battleOpen = false;
+      if (wildDex == 151) mew++;
+      else if (wildDex >= 144 && wildDex <= 150 && wildDex != 147 && wildDex != 148 && wildDex != 149) otherLegend++;
+    }
+    printf("      only MEW missing, Lure on: %d of %d encounters were MEW\n", mew, N);
+    CHECK(mew > N * 7 / 100 && mew < N * 14 / 100, "the Lure finds the missing legendary about 10% of the time");
+    int plain = 0;
+    while (bag.lureLeft()) bag.useLure();
+    for (int i = 0; i < N; i++) { startWildBattle(0, false); battleOpen = false; if (wildDex == 151) plain++; }
+    printf("      without the Lure: %d of %d\n", plain, N);
+    CHECK(plain < N * 2 / 100, "without it MEW stays as rare as before");
+    // while an ordinary species is still missing, the Lure never hands out a legendary
+    pet.dexReg[(10 - 1) >> 3] &= ~(1 << ((10 - 1) & 7));   // CATERPIE missing again
+    int legend = 0;
+    for (int i = 0; i < 400; i++) {
+      bag.addLure(1); startWildBattle(0, false); battleOpen = false;
+      if (wildDex == 151) legend++;
+      pet.dexReg[(10 - 1) >> 3] &= ~(1 << ((10 - 1) & 7));
+    }
+    printf("      CATERPIE and MEW missing, Lure on: %d of 400 were MEW\n", legend);
+    CHECK(legend < 12, "with an ordinary species missing, the Lure does not boost legendaries");
+  }
+
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/vitrine_test.cpp b/tools/emu/tests/vitrine_test.cpp
