-void Inventory::save() {
+void Inventory::writeBag() {
+  if (batching) { dirtyBag = true; return; }
   prefs.putBytes("bag", counts, sizeof(counts));
 }
+void Inventory::writeCash() {
+  if (batching) { dirtyCash = true; return; }
+  prefs.putUInt("cash", money);
+}
+void Inventory::save() { writeBag(); }
+
+void Inventory::endBatch() {
+  if (!batching) return;
+  batching = false;
+  if (dirtyBag) prefs.putBytes("bag", counts, sizeof(counts));
+  if (dirtyCash) prefs.putUInt("cash", money);
+  dirtyBag = dirtyCash = false;
+}
+
+bool Inventory::addLure(uint8_t n) {
+  if ((uint16_t)lure + n > 99) return false;
+  lure = (uint8_t)(lure + n);
+  prefs.putUChar("lure", lure);
+  return true;
+}
+void Inventory::useLure() {
+  if (!lure) return;
+  lure--;
+  if (lure) prefs.putUChar("lure", lure); else prefs.remove("lure");
+}
 
 void Inventory::clear() {
   memset(counts, 0, sizeof(counts));
   save();
+  money = 0;
+  prefs.remove("cash");
+  lure = 0;
+  prefs.remove("lure");   // a reset game starts like a new one, welcome sum included
+}
+
+uint32_t Inventory::addCash(uint32_t n) {
+  uint32_t room = CASH_MAX - money;
+  uint32_t got = n < room ? n : room;
+  if (!got) return 0;
+  money += got;
+  writeCash();
+  return got;
+}
+
+bool Inventory::spendCash(uint32_t n) {
+  if (!n || money < n) return false;
+  money -= n;
+  writeCash();
+  return true;
 }
 
 void Inventory::grantStarterKit() {
