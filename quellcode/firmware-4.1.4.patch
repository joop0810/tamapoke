+uint32_t g_seed=2; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop(); void render();
+extern Pet pet; extern Arduino_Canvas *gfx;
+extern bool galleryOpen, galleryPick, galleryDirty; extern uint8_t galleryDetail, galleryRegion;
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+static void shot(const char *path) {
+  render();
+  const uint16_t *fb = gfx->buffer();
+  FILE *f = fopen(path, "wb"); if (!f) return;
+  fprintf(f, "P6\n466 466\n255\n");
+  for (int i = 0; i < 466 * 466; i++) { uint16_t c = fb[i];
+    unsigned char px[3] = { (unsigned char)((c >> 11) << 3), (unsigned char)(((c >> 5) & 63) << 2), (unsigned char)((c & 31) << 3) };
+    fwrite(px, 1, 3, f); }
+  fclose(f);
+}
+int main() {
+  CHECK(gLang == LANG_DEFAULT && LANG_DEFAULT == LANG_EN, "English is still the default language");
+  CHECK(!strcmp(speciesName(45), "VILEPLUME"), "in English 45 is VILEPLUME");
+  gLang = LANG_DE;
+  CHECK(!strcmp(speciesName(45), "GIFLOR"), "in German 45 is GIFLOR");
+  CHECK(!strcmp(speciesName(187), "HOPPSPROSS"), "187 is HOPPSPROSS");
+  CHECK(!strcmp(speciesName(6), "GLURAK") && !strcmp(speciesName(4), "GLUMANDA"), "GLUMANDA / GLURAK");
+  CHECK(!strcmp(speciesName(29), "NIDORAN W") && !strcmp(speciesName(32), "NIDORAN M"), "the Nidoran symbols read W / M");
+  CHECK(!strcmp(speciesName(1025), "INFAMOMO"), "the last species has its German name");
+  bool ascii = true; size_t longest = 0;
+  for (int d = 1; d <= DEX_COUNT; d++) { const char *n = speciesName(d); longest = strlen(n) > longest ? strlen(n) : longest;
+    for (const char *c = n; *c; c++) if (*c < 32 || *c > 126) ascii = false; }
+  CHECK(ascii, "every German name is plain ASCII (the panel font has no umlauts)");
+  CHECK(longest <= 13, "no German name is longer than 13 characters");
+  CHECK(speciesName(-3) == speciesName(0) && speciesName(5000) == speciesName(0), "out-of-range numbers are safe");
+  gLang = LANG_FR;
+  CHECK(!strcmp(speciesName(45), "VILEPLUME"), "other languages keep the English name");
+
+  gLang = LANG_EN;
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(45, false);
+  gLang = LANG_DE;
+  shot("names_main.ppm");
+  for (int d = 1; d <= 60; d++) pet.dbgHatchAs(d, false);
+  pet.dbgHatchAs(45, false);
+  galleryOpen = true; galleryPick = false; galleryRegion = 0; galleryDetail = 45; galleryDirty = true;
+  shot("names_gallery.ppm");
+  galleryOpen = false; galleryDetail = 0;
+  CHECK(pet.speciesId == 45, "the save still holds the dex NUMBER, not a name");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
diff --git a/tools/emu/tests/nvsbudget_test.cpp b/tools/emu/tests/nvsbudget_test.cpp
new file mode 100644
index 00000000..28d330d5
--- /dev/null
+++ b/tools/emu/tests/nvsbudget_test.cpp
@@ -0,0 +1,74 @@
+// Dennis build: how many NVS entries a realistic save keeps live, and how many
+// writes one wild fight costs. NVS cost model (ESP-IDF): 32-byte entries, a
+// primitive = 1 entry, a string = 1 + ceil(len/32), a blob = one index entry +
+// per chunk 1 header + ceil(len/32). The 20 KB partition has 5 x 126 entries;
+// one page is reserved, and the firmware warns when fewer than 126 remain:
+// i.e. when live entries exceed 504 - 126 = 378.
+#include "Arduino.h"
+#include "Arduino_GFX_Library.h"
+#include "Preferences.h"
+#include "pet.h"
+#include "party.h"
+#include "wild.h"
+#include "battle.h"
+#include "items.h"
+#include "inventory.h"
+#include "nvsinfo.h"
+#include <cstdio>
+uint32_t g_seed=3; FakeSerial Serial; FakeESP ESP; FakeWire Wire;
+volatile int g_touchX=0,g_touchY=0; volatile bool g_touchDown=false;
+void FakeESP::restart(){exit(0);}
+int FakeSerial::available(){return 0;}
+String FakeSerial::readStringUntil(char){return String("");}
+void setup(); void loop();
+bool startWildBattle(uint8_t region, bool hard);
+void btlAwardExp(bool narrate);
+extern Pet pet; extern Party party; extern Inventory bag;
+extern uint16_t squadMask; extern uint8_t btlFought;
+static unsigned entriesFor(size_t len) { return 1 + (unsigned)((len + 31) / 32); }
+static unsigned report(const char *label) {
+  unsigned total = 0;
+  printf("---- %s\n", label);
+  for (auto &kv : nvs()) {
+    size_t n = kv.second.size();
+    unsigned e = n <= 8 ? 1 : 1 + entriesFor(n);   // >8 bytes: blob (index + chunk)
+    total += e;
+    if (e > 2) printf("   %-14s %5u bytes  %3u entries\n", kv.first.c_str(), (unsigned)n, e);
+  }
+  printf("   keys=%u  live entries=%u  (warning above 378, hard limit 504)\n", (unsigned)nvs().size(), total);
+  return total;
+}
+static int bad = 0;
+#define CHECK(c, msg) do { if (c) printf("PASS  %s\n", msg); else { printf("FAIL  %s\n", msg); bad++; } } while (0)
+int main() {
+  setup();
+  for (int i = 0; i < 4; i++) loop();
+  if (pet.awaitingStarter()) pet.chooseStarter(4);
+  pet.dbgHatchAs(5, false);
+  pet.ageMinutes = 20UL * MINUTES_PER_LEVEL;
+  report("fresh save");
+  // a well-played save: full team, box half full, a bag of items
+  for (int i = 0; i < PARTY_SLOTS; i++) { PartyMon m; m.dex = 10 + i; m.level = 12; m.stateVersion = 1; m.ageMinutes = 11UL * 60; party.replaceAt(i, m); }
+  for (int i = 0; i < 18; i++) { PartyMon m; m.dex = 30 + i; m.level = 8; m.stateVersion = 1; party.boxAdd(m); }
+  for (int k = 1; k < ITEM_COUNT; k++) bag.add((ItemKey)k, 3);
+  party.save(); pet.saveNow();
+  unsigned live = report("full team, box 18, bag full");
+
+  // writes per wild fight, with and without the EXP award
+  squadMask = 0x7;
+  nvsFailWritesAfter(1000000);
+  startWildBattle(0, false);
+  for (int i = 0; i < 6; i++) loop();
+  int afterStart = nvsWriteBudget();
+  btlFought = 0x7;
+  btlAwardExp(false);
+  int afterExp = nvsWriteBudget();
+  nvsResumeWrites();
+  printf("---- writes: starting a fight %d, the EXP award %d\n", 1000000 - afterStart, afterStart - afterExp);
+  // the 4.0.8 warning rule, on the real partition (5 pages x 126 = 630 entries)
+  CHECK(!nvsLowFromStats(live, 630), "a well-played save is nowhere near the warning");
+  CHECK(!nvsLowFromStats(378, 630) && nvsLowFromStats(379, 630), "it lights when live data leaves less than one spare page");
+  CHECK(!nvsLowFromStats(0, 0), "unreadable stats never light it");
+  printf(bad ? "FAILURES\n" : "all good\n");
+  return bad ? 1 : 0;
+}
